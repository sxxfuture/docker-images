ARG PG_VERSION=18
ARG EXTENSIONS="vector=0.8.7 postgis=3.7.0 vchord=1.3.0 pgvectorscale=0.9.1 pg_cron=1.6.8 pg_vectorize=0.27.1 hashtypes=0.1.5 pg_search=0.26.6 pg_tokenizer=1.1.0 pgmq=1.13.1 pg_uuidv7=1.7.0 pg_lease=0.1.0"

FROM debian:13-slim

ARG PG_VERSION
ARG EXTENSIONS
ARG PIG_VERSION=
ARG PGDATA=/var/lib/postgresql/${PG_VERSION%%.*}/docker
ARG DEBIAN_FRONTEND=noninteractive

ENV PG_MAJOR=${PG_VERSION%%.*}
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/postgresql/${PG_MAJOR}/bin \
    LANG=en_US.utf8 \
    PGDATA=${PGDATA}

RUN --mount=type=bind,source=pem,target=/pem \
    --mount=type=cache,id=postgres-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=postgres-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    bash <<'EOF'
set -eux
source /pem/sourceme
pem::init "${PG_VERSION}" ${EXTENSIONS}
EOF

VOLUME ${PGDATA}

STOPSIGNAL SIGINT
EXPOSE 5432
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["postgres"]
